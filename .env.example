# =============================================================
# Demo GPS de Contexto — Banco Bússola
# Copie para .env (cp .env.example .env) e preencha os segredos.
# Nunca versione o .env.
# =============================================================

# --- Provedor de LLM (anthropic | azure_openai) ---------------
# Sem chave, o agent sobe e roda só o provedor "roteiro" (ensaio sem LLM).
LLM_PROVIDER=anthropic
# Onde o Claude roda: foundry (Microsoft Foundry, na Azure) | api (API da Anthropic)
ANTHROPIC_PLATAFORMA=foundry
# Microsoft Foundry: o endpoint do recurso (termina em /anthropic/) e a chave dele
ANTHROPIC_FOUNDRY_BASE_URL=https://eastus2.api.cognitive.microsoft.com/anthropic/
ANTHROPIC_FOUNDRY_API_KEY=
# API da Anthropic (só com ANTHROPIC_PLATAFORMA=api)
ANTHROPIC_API_KEY=
# Na API, o id do modelo; no Foundry, o nome do deployment. Padrão das execuções (o painel pode trocar)
ANTHROPIC_MODEL=claude-haiku-5-5
# Outros modelos que uma execução pode pedir (seletor do painel, "modelo" na API, --modelo), separados por vírgula
ANTHROPIC_MODELOS=claude-opus-5-5
# Preço por token, em US$, de cada modelo (custo por execução, placar e relatórios)
LLM_PRECOS={"claude-opus-5-5": {"entrada": 0.000004, "saida": 0.00002}, "claude-haiku-5-5": {"entrada": 0.0000001, "saida": 0.0000005}}
# Cache de prompt: leitura a uma fração do preço de entrada; escrita com acréscimo
CACHE_LEITURA_FATOR=0.1
CACHE_ESCRITA_FATOR=1.25
# Esforço do modelo: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Fallback do lado do servidor quando o modelo recusa (true | false). Não existe no Foundry: lá fica desligado.
ANTHROPIC_FALLBACKS=true
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- Grafo (Neo4j) --------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-esta-senha

# --- Gateway --------------------------------------------------
# Token que o agent apresenta ao mcp-gateway.
GATEWAY_TOKEN=troque-este-token

# --- Simulador ------------------------------------------------
# Token das rotas internas do contexto-mcp (só o simulador usa).
SIMULADOR_TOKEN=troque-este-token-do-simulador

# --- Login da demo -------------------------------------------
# Sem login, nenhuma parte da demo abre. Crie cada usuário com:
#   ./scripts/criar-usuario.sh <nome>
# e cole a linha gerada aqui, separando os usuários por vírgula:
#   AUTH_USUARIOS=ana=scrypt.16384.8.1....,ricardo=scrypt.16384.8.1....
AUTH_USUARIOS=
# Assina os cookies de sessão. Use um valor longo e aleatório (ex.: openssl rand -base64 32).
# Trocar o segredo derruba todas as sessões abertas.
AUTH_SEGREDO=troque-este-segredo
# Duração da sessão, em horas.
AUTH_SESSAO_HORAS=12
# true quando a demo estiver atrás de HTTPS: o navegador só envia o cookie por conexão segura.
AUTH_COOKIE_SEGURO=false

# --- Execução -------------------------------------------------
# ao_vivo | replay
DEMO_MODO=ao_vivo
LOG_LEVEL=INFO

# --- Portas no host -------------------------------------------
WEB_PORT=8080
# O Neo4j só escuta no próprio servidor (127.0.0.1). Use 0.0.0.0 apenas numa rede de confiança.
NEO4J_BIND=127.0.0.1
NEO4J_BROWSER_PORT=7474
NEO4J_BOLT_PORT=7687
